// wasm — vrm-inspect / converter-ui のグルーから呼ぶ。
//   host が GLB バイト列を in_alloc バッファに書き、各 export がそこから読む。
//   返すのは全て Int(オフセット/長さ/フラグ)を Float 化したもの。string は跨がせない。
//   (offset を返し、JSON 本体の切り出し+JSON.parse は host 側で行う。)
import self as glb
import bytes
import ffi
import float
import int

var g_in: Region = ffi.region(bytes.new())

@export(wasm, "in_alloc", returns: address)
effect fn in_alloc(len: Float) -> Region = {
  g_in = ffi.alloc(int.from_saturating(len))!
  g_in
}

@export(wasm, "is_glb")
effect fn w_is_glb() -> Float = if glb.is_glb(ffi.to_bytes(g_in)!) then 1.0 else 0.0

@export(wasm, "version")
effect fn w_version() -> Float = float.from(glb.version(ffi.to_bytes(g_in)!))

@export(wasm, "total_length")
effect fn w_total_length() -> Float = float.from(glb.total_length(ffi.to_bytes(g_in)!))

@export(wasm, "json_offset")
fn w_json_offset() -> Float = float.from(glb.json_offset())

@export(wasm, "json_chunk_length")
effect fn w_json_chunk_length() -> Float = float.from(glb.json_chunk_length(ffi.to_bytes(g_in)!))

@export(wasm, "json_type_ok")
effect fn w_json_type_ok() -> Float = if glb.json_type_ok(ffi.to_bytes(g_in)!) then 1.0 else 0.0

@export(wasm, "bin_chunk_offset")
effect fn w_bin_chunk_offset() -> Float = float.from(glb.bin_chunk_offset(ffi.to_bytes(g_in)!))

@export(wasm, "bin_chunk_length")
effect fn w_bin_chunk_length() -> Float = float.from(glb.bin_chunk_length(ffi.to_bytes(g_in)!))

@export(wasm, "bin_data_offset")
effect fn w_bin_data_offset() -> Float = float.from(glb.bin_data_offset(ffi.to_bytes(g_in)!))

@export(wasm, "has_bin_chunk")
effect fn w_has_bin_chunk() -> Float = if glb.has_bin_chunk(ffi.to_bytes(g_in)!) then 1.0 else 0.0

@export(wasm, "is_valid")
effect fn w_is_valid() -> Float = if glb.is_valid(ffi.to_bytes(g_in)!) then 1.0 else 0.0

effect fn main() -> Unit = {
  let _a = in_alloc(1.0)!
  let _b = w_is_glb()!
  let _c = w_version()!
  let _d = w_total_length()!
  let _e = w_json_chunk_length()!
  let _f = w_bin_chunk_offset()!
  let _g = w_is_valid()!
  ()
}
